#!/usr/bin/env bash
# post-commit 钩子：提交后自动格式化，有漂移则追加一个 style 提交。
#
# 递归防护：style 提交自身会再触发 post-commit，用环境变量挡住二次执行。
# 在途工作保护：只提交「格式化后出现、格式化前不存在」的文件，不把未提交的
# 在途改动误并进 style 提交。
# 仓库还没有 Cargo.toml 时直接跳过（骨架任务之前正常存在）。

if [ -n "$ITA_HOOK" ]; then
  exit 0
fi

[ -f Cargo.toml ] || exit 0
command -v cargo >/dev/null 2>&1 || exit 0

tmp_before=$(mktemp)
tmp_after=$(mktemp)
trap 'rm -f "$tmp_before" "$tmp_after"' EXIT

git status --porcelain > "$tmp_before"
if cargo fmt --all 2>/dev/null; then
  git status --porcelain > "$tmp_after"
  fmt_files=$(comm -13 \
    <(awk 'NF{print $2}' "$tmp_before" | sort -u) \
    <(awk 'NF{print $2}' "$tmp_after"  | sort -u))
  if [ -n "$fmt_files" ]; then
    git add -- $fmt_files
    ITA_HOOK=1 git commit --no-verify -m "style: 自动格式化"
    echo "post-commit: 已创建格式化提交 $(git rev-parse --short HEAD)"
  fi
fi
